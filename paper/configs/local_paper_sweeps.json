{
  "experiment_name": "paper-sweeps-standardized-local",
  "output_root": "../../out/experiments",
  "overwrite_output": false,
  "workloads": [
    {
      "name": "jpb-sweep-joins",
      "kind": "cross_product",
      "post_variant_setup_sql": [
        "SET disabled_optimizers=current_setting('disabled_optimizers') || ',join_order,build_side_probe_side';"
      ],
      "params": {
        "fixed": {
          "fact_rows": 500000000,
          "dimension_cardinality": 100000000,
          "key_domain_size": 100000000,
          "selectivity": 0.01,
          "join_count": 1,
          "build_key_multiplicity": 1,
          "probe_layout": "uniform",
          "row_group_size": 122880,
          "dummy_string_cols": 2,
          "dummy_string_len": 8,
          "seed": 7
        },
        "sweep": {
          "kind": "join_count",
          "values": [
            1,
            2,
            3,
            4,
            5
          ]
        },
        "query_types": [
          {
            "kind": "shoulder",
            "probe_layouts": [
              "uniform"
            ]
          },
          {
            "kind": "scattered",
            "probe_layouts": [
              "uniform"
            ]
          }
        ]
      }
    },
    {
