+static bool CanPruneFileByNumericRuntimeFilter(const DuckLakeFileListEntry &file,
+                                               const FilterPushdownInfo &filters) {
+	for (auto &entry : filters.column_filters) {
+		auto &column = entry.second;
+		if (!column.column_type.IsNumeric() || !column.table_filter->expr) {
+			continue;
+		}
+		auto bounds = file.column_min_max.find(column.column_field_index);
+		if (bounds == file.column_min_max.end() || bounds->second.first.empty() || bounds->second.second.empty()) {
+			continue;
+		}
+		Value lower, upper;
+		if (!Value(bounds->second.first).DefaultTryCastAs(column.column_type, lower, nullptr) ||
+		    !Value(bounds->second.second).DefaultTryCastAs(column.column_type, upper, nullptr) || lower > upper) {
+			continue;
+		}
+		auto stats = NumericStats::CreateUnknown(column.column_type);
+		NumericStats::SetMin(stats, lower);
+		NumericStats::SetMax(stats, upper);
+		// Delegate conjunctions and optional filters to DuckDB's statistics logic.
+		// Keep files with missing/invalid bounds or an uninitialized runtime filter.
+		if (column.table_filter->CheckStatistics(stats) == FilterPropagateResult::FILTER_ALWAYS_FALSE) {
+			return true;
+		}
+	}
+	return false;
+}
