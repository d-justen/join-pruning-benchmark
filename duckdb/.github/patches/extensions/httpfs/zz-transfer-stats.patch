 namespace duckdb {
 
+
+static void ResetHTTPTransfers(DataChunk &input, ExpressionState &state, Vector &result) {
+	HTTPState::TryGetState(state.GetContext())->ResetTransfers();
+	result.Reference(Value::BOOLEAN(true), count_t(input.size()));
+}
+
+struct HTTPTransfersState : public GlobalTableFunctionState {
+	vector<pair<string, HTTPTransferStats>> entries;
+	idx_t offset = 0;
+};
+
+static unique_ptr<FunctionData> BindHTTPTransfers(ClientContext &, TableFunctionBindInput &,
+                                                 vector<LogicalType> &types, vector<string> &names) {
+	types = {LogicalType::VARCHAR, LogicalType::UBIGINT, LogicalType::UBIGINT};
+	names = {"url", "bytes_received", "get_requests"};
+	return nullptr;
+}
+
+static unique_ptr<GlobalTableFunctionState> InitHTTPTransfers(ClientContext &context, TableFunctionInitInput &) {
+	auto result = make_uniq<HTTPTransfersState>();
+	for (auto &entry : HTTPState::TryGetState(context)->SnapshotTransfers()) {
+		result->entries.emplace_back(entry.first, entry.second);
+	}
+	return std::move(result);
+}
+
+static void ScanHTTPTransfers(ClientContext &, TableFunctionInput &input, DataChunk &output) {
+	auto &state = input.global_state->Cast<HTTPTransfersState>();
+	idx_t count = 0;
+	while (state.offset < state.entries.size() && count < STANDARD_VECTOR_SIZE) {
+		auto &entry = state.entries[state.offset++];
+		output.data[0].Append(Value(entry.first));
+		output.data[1].Append(Value::UBIGINT(entry.second.bytes));
+		output.data[2].Append(Value::UBIGINT(entry.second.requests));
+		count++;
+	}
+	output.SetCardinality(count);
+}
+
 static void LoadInternal(ExtensionLoader &loader) {
+	auto reset = ScalarFunction("httpfs_reset_transfer_stats", {}, LogicalType::BOOLEAN, ResetHTTPTransfers);
+	reset.SetStability(FunctionStability::VOLATILE);
+	loader.RegisterFunction(reset);
+	loader.RegisterFunction(TableFunction("httpfs_transfer_stats", {}, ScanHTTPTransfers, BindHTTPTransfers, InitHTTPTransfers));
 	auto &instance = loader.GetDatabaseInstance();
 	auto &fs = instance.GetFileSystem();
 
