+struct HTTPTransferStats {
+	idx_t bytes = 0;
+	idx_t requests = 0;
+};
+
 class HTTPState : public ClientContextState {
 public:
+	// Explicitly scoped counters survive QueryEnd so the following SQL statement can read them.
+	void ResetTransfers() {
+		lock_guard<mutex> guard(transfer_mutex);
+		transfers.clear();
+		track_transfers = true;
+	}
+	void RecordTransfer(const string &url, idx_t bytes, idx_t requests) {
+		if (!track_transfers) {
+			return;
+		}
+		lock_guard<mutex> guard(transfer_mutex);
+		// Never retain signed query parameters or credentials in result artifacts.
+		auto &entry = transfers[url.substr(0, url.find('?'))];
+		entry.bytes += bytes;
+		entry.requests += requests;
+	}
+	unordered_map<string, HTTPTransferStats> SnapshotTransfers() {
+		lock_guard<mutex> guard(transfer_mutex);
+		return transfers;
+	}
 	//! Reset all counters and cached files
 	void Reset();
 	//! Get cache entry, create if not exists
