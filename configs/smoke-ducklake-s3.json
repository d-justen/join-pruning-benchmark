{
  "experiment_name": "smoke-ducklake-s3",
  "output_root": "/results",
  "overwrite_output": false,
  "workloads": [
    {
      "name": "join-pruning-workload-ducklake",
      "kind": "cross_product",
      "params": {
        "fixed": {
          "fact_rows": 1048576,
          "dimension_cardinality": 1000000,
          "key_domain_size": "dimension_cardinality",
          "selectivity": 0.01,
          "join_count": 1,
          "build_key_multiplicity": 1,
          "probe_layout": "ordered",
          "row_group_size": 122880,
          "dummy_string_cols": 2,
          "dummy_string_len": 8,
          "seed": 7,
          "fact_payload_cols": 4,
          "fact_payload_len": 32,
          "projected_fact_payload_cols": 2
        },
        "sweep": {
          "kind": "dimension_cardinality",
          "values": [
            1000000
          ]
        },
        "query_types": [
          {
            "kind": "range"
          },
          {
            "kind": "shoulder"
          },
          {
            "kind": "seasonal",
            "cluster_count": 8
          },
          {
            "kind": "seasonal",
            "cluster_count": 16
          },
          {
            "kind": "seasonal",
            "cluster_count": 32
          },
          {
            "kind": "scattered"
          }
        ],
        "storage": {
          "kind": "ducklake",
          "data_source": "s3",
          "parquet_row_group_size": 8192,
          "parquet_row_groups_per_file": 4
        }
      },
      "estimated_peak_gib": 8
    }
  ],
  "systems": [
    {
      "name": "duckdb-paper",
      "kind": "binary",
      "variants": [
        {
          "label": "no prefilter",
          "setup_sql": [
            "SET enable_prefix_range_filter=false;",
            "SET enable_join_min_max_filter_pushdown=false;",
            "SET enable_join_bloom_filter_pushdown=false;",
            "SET enable_perfect_hash_join_filter_pushdown=false;",
            "SET dynamic_or_filter_threshold=0;",
            "SET disabled_optimizers='compressed_materialization';"
          ]
        },
        {
          "label": "sip",
          "setup_sql": [
            "SET enable_prefix_range_filter=false;",
            "SET enable_join_min_max_filter_pushdown=false;",
            "SET enable_join_bloom_filter_pushdown=true;",
            "SET enable_perfect_hash_join_filter_pushdown=false;",
            "SET dynamic_or_filter_threshold=0;",
            "SET disabled_optimizers='compressed_materialization';"
          ]
        },
        {
          "label": "sip + min/max",
          "setup_sql": [
            "SET enable_prefix_range_filter=false;",
            "SET enable_join_min_max_filter_pushdown=true;",
            "SET enable_join_bloom_filter_pushdown=true;",
            "SET enable_perfect_hash_join_filter_pushdown=false;",
            "SET dynamic_or_filter_threshold=0;",
            "SET disabled_optimizers='compressed_materialization';"
          ]
        },
        {
          "label": "prf with fallback",
          "setup_sql": [
            "SET enable_prefix_range_filter=true;",
            "SET enable_prefix_range_filter_compression=true;",
            "SET enable_join_min_max_filter_pushdown=true;",
            "SET enable_join_bloom_filter_pushdown=true;",
            "SET enable_perfect_hash_join_filter_pushdown=false;",
            "SET dynamic_or_filter_threshold=0;",
            "SET disabled_optimizers='compressed_materialization';"
          ]
        }
      ],
      "binary_path": "/opt/prf/duckdb"
    }
  ],
  "benchmark": {
    "repetitions": 2,
    "threads": 4,
    "prepare_duckdb_binary": "duckdb",
    "collect_profiles": true,
    "memory_limit": "4GiB",
    "max_temp_directory_size": "8GiB"
  },
  "suite": {
    "checkpoint_queries": true,
    "checkpoint_microbenchmarks": true,
    "container_memory": "7g",
    "container_cpus": 4,
    "timeout_seconds": 1200,
    "prepare_timeout_seconds": 1800,
    "disk_reserve_gib": 2,
    "evict_datasets": true,
    "paper_figures": true,
    "validate_diva": false,
    "required_workloads": [
      "join-pruning-workload-ducklake"
    ],
    "required_figures": [
      "join_pruning_ordered_ducklake"
    ]
  },
  "datasets": {}
}
